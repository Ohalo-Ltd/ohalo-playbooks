# Application
APP_NAME=Graph RAG
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=graphrag
POSTGRES_PASSWORD=graphrag
POSTGRES_DB=graphrag

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag123

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o-mini

# Data X-Ray
DXR_API_KEY=your-dxr-api-key-here
DXR_BASE_URL=https://api.dataxray.com

# Security
# IMPORTANT: SECRET_KEY is used for encrypting sensitive data (e.g., DXR API tokens) in the database
# Generate a strong key using: openssl rand -hex 32
# DO NOT share this key or commit it to version control
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logfire (optional)
LOGFIRE_TOKEN=
