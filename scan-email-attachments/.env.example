# DataXray API Configuration
# The base URL must end in /api
DATAXRAY_BASE_URL=https://your-dataxray-host/api
DATAXRAY_API_KEY=your_api_key_here
DATASOURCE_ID=100
# Set to false only for a DataXray instance with a self-signed certificate
DATAXRAY_VERIFY_TLS=true

# SMTP Proxy Configuration
SMTP_PROXY_HOST=0.0.0.0
SMTP_PROXY_PORT=1025

# MailHog Configuration
MAILHOG_HOST=mailhog
MAILHOG_PORT=1026

# Logging Configuration
LOG_LEVEL=INFO
